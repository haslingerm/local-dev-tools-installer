<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevToolsManager.App.ViewModels"
             x:Class="DevToolsManager.App.Views.CleanupTabView"
             x:DataType="vm:CleanupTabViewModel">

    <DockPanel Margin="24,20,24,20">

        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Cleanup" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Text="Reclaim disk space by removing managed installs you no longer need. Active versions and system installs are protected."/>
            <TextBlock Text="{Binding TotalLabel}"
                       Margin="0,8,0,0"
                       FontWeight="SemiBold"
                       IsVisible="{Binding TotalLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="2" Margin="0,8,0,0"/>
        </StackPanel>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CleanupGroupViewModel">
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>

                            <Border IsVisible="{Binding IsEmpty}"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="4" Padding="10,8">
                                <TextBlock Text="(none installed)"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CleanupItemViewModel">
                                        <Border Margin="0,0,0,4" Padding="12,8"
                                                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                                CornerRadius="4">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Version}" FontWeight="SemiBold"/>
                                                    <Border IsVisible="{Binding IsActive}"
                                                            Background="{DynamicResource SystemAccentColor}"
                                                            CornerRadius="3" Padding="4,1">
                                                        <TextBlock Text="active" FontSize="10" Foreground="White"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding StatusMessage}"
                                                               FontSize="11"
                                                               Foreground="Red"
                                                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SizeLabel}"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

                                                <Button Grid.Column="2"
                                                        Content="{Binding RemoveLabel}"
                                                        IsEnabled="{Binding CanRemove}"
                                                        ToolTip.Tip="{Binding ActiveTooltip}"
                                                        Command="{Binding $parent[ItemsControl].((vm:CleanupTabViewModel)DataContext).RemoveCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
