<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DotnetSdkManager.App.ViewModels"
             x:Class="DotnetSdkManager.App.Views.BootstrapPageView"
             x:DataType="vm:BootstrapPageViewModel">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
        <StackPanel Spacing="16" Margin="32">

            <TextBlock Text="Welcome to .NET SDK Manager"
                       FontSize="22"
                       FontWeight="Bold"
                       TextAlignment="Center"/>

            <TextBlock TextAlignment="Center" TextWrapping="Wrap">
                To let <Run FontWeight="SemiBold">dotnet</Run> work in any terminal and in Rider,
                this tool needs to add one entry to your PATH — just once.
            </TextBlock>

            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="4" Padding="12,8">
                <StackPanel Spacing="4">
                    <TextBlock Text="The following path will be added:"
                               FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="{Binding ActiveLinkPath}"
                               FontFamily="Monospace"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Switching default later re-targets this path — PATH is never changed again."
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       TextAlignment="Center"/>

            <Button Content="Set up PATH"
                    Command="{Binding BootstrapCommand}"
                    IsEnabled="{Binding IsRunning, Converter={x:Static BoolConverters.Not}}"
                    HorizontalAlignment="Center"
                    Padding="24,8"/>

            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunning}" Height="3"/>

            <TextBlock Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>

        </StackPanel>
    </Grid>

</UserControl>
